import torch
import torch.nn as nn
import torch.nn.functional as F

print("=== Avcı AI 3 Pro Başlatılıyor ===")

# 1. Eğitim Metni ve Sözlük (Tokenizer) Hazırlığı
text = "Avcı AI 3 Pro geleceğin en gelişmiş yapay zeka modelidir."
chars = sorted(list(set(text)))
vocab_size = len(chars)

char_to_ix = {ch: i for i, ch in enumerate(chars)}
ix_to_char = {i: ch for i, ch in enumerate(chars)}

def encode(s):
    return [char_to_ix[c] for c in s if c in char_to_ix]

def decode(l):
    return ''.join([ix_to_char[i] for i in l])

# 2. Avcı AI 3 Pro Basit Transformer Mimarisi
class AvciAI3Pro(nn.Module):
    def __init__(self, vocab_size, embed_dim=32, hidden_dim=64):
        super(AvciAI3Pro, self).__init__()
        self.embedding = nn.Embedding(vocab_size, embed_dim)
        self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True)
        self.fc = nn.Linear(hidden_dim, vocab_size)

    def forward(self, x):
        out = self.embedding(x)
        out, _ = self.lstm(out)
        out = self.fc(out)
        return out

# Model Kurulumu
model = AvciAI3Pro(vocab_size)
print(f"Avcı AI 3 Pro Modeli Başarıyla Oluşturuldu! (Sözlük Boyutu: {vocab_size})")

# Örnek Test
test_input = "Avcı"
encoded_input = torch.tensor([encode(test_input)])
output = model(encoded_input)

print(f"Girdi: '{test_input}'")
print(f"Çıktı Temsil Boyutu: {output.shape}")
