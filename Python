def generate_text(model, start_str, length=30):
    model.eval()
    current_str = start_str
    
    with torch.no_grad():
        for _ in range(length):
            input_tensor = torch.tensor([encode(current_str)])
            output = model(input_tensor)
            
            # En yüksek olasılıklı sonraki karakteri seç
            last_token_logits = output[0, -1, :]
            predicted_ix = torch.argmax(last_token_logits).item()
            
            next_char = ix_to_char[predicted_ix]
            current_str += next_char
            
    return current_str

