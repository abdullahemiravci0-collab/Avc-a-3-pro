# 1. Eğitim Verimiz
training_data = "avcı ai 3 pro geleceğin en gelişmiş yapay zeka modelidir. avcı ai metin üretir ve öğrenir."

# Sözlük Oluşturma
chars = sorted(list(set(training_data)))
